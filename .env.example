# Copy to .env for running on your own computer. Never commit .env.
JIRA_SITE=yourname.atlassian.net
JIRA_EMAIL=you@university.edu.pk
JIRA_TOKEN=paste-your-api-token
JIRA_PROJECT=PER

# Optional: a free Gemini API key from https://aistudio.google.com/apikey
# Lets it invent fresh task ideas when your list runs low, and read free-text tasks from issues.
GEMINI_API_KEY=
