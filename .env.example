# Copy to .env for running on your own computer. Never commit .env.
JIRA_SITE=yourname.atlassian.net
JIRA_EMAIL=you@university.edu.pk
JIRA_TOKEN=paste-your-api-token
JIRA_PROJECT=PER

# Optional: lets the tool ask an AI for fresh task ideas when it runs low.
# Any OpenAI-compatible API works. Pick ONE set:
# Gemini (free tier):  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  LLM_MODEL=gemini-2.5-flash
# DeepSeek:            LLM_BASE_URL=https://api.deepseek.com                                LLM_MODEL=deepseek-chat
# OpenAI:              LLM_BASE_URL=https://api.openai.com/v1                               LLM_MODEL=gpt-4o-mini
# Groq (free tier):    LLM_BASE_URL=https://api.groq.com/openai/v1                          LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
